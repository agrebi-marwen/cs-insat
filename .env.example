# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server only. Needed by the CP judge and the test-file upload.
SUPABASE_SERVICE_ROLE_KEY=
# Second factor for the admin panel (server only).
ADMIN_PASSWORD=
# Piston code runner, e.g. http://localhost:2000/api/v2
PISTON_BASE_URL=
PISTON_API_KEY=
# Optional: persistent auth rate limiting across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
